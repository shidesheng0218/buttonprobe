{
  "name": "buttonprobe",
  "version": "0.1.0-alpha.2",
  "description": "AI-powered dead button detector and verified repair loop for local React apps. BYOK, Claude/Ollama-friendly, zero backend.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shidesheng0218/buttonprobe.git"
  },
  "homepage": "https://github.com/shidesheng0218/buttonprobe#readme",
  "bugs": {
    "url": "https://github.com/shidesheng0218/buttonprobe/issues"
  },
  "keywords": [
    "button",
    "ui-testing",
    "react",
    "vite",
    "playwright",
    "ai",
    "repair",
    "verified-diff",
    "ollama",
    "claude",
    "byok",
    "mcp",
    "mcp-server",
    "claude-code"
  ],
  "type": "module",
  "bin": {
    "buttonprobe": "./dist/cli.js"
  },
  "exports": {
    "./vite": {
      "types": "./dist/vite.d.ts",
      "default": "./dist/vite.js"
    }
  },
  "files": [
    "dist",
    "docs/buttonprobe-demo.gif",
    "docs/buttonprobe-action-proof.gif",
    "docs/providers.md",
    "docs/launch/demo-script.md",
    "docs/launch/hn-post.md",
    "docs/launch/reddit-post.md",
    "docs/launch/release-v0.1.0-alpha.1.md",
    "docs/launch/release-v0.1.0-alpha.2.md",
    "docs/launch/action-marketplace.md",
    "docs/launch/x-thread.md",
    "docs/recipes",
    "action.yml",
    "benchmarks",
    "scripts",
    "examples",
    "fixtures/viral-demo-react",
    "fixtures/react-repair-suite",
    "fixtures/vue-repair-suite",
    "fixtures/external-react",
    "README.md",
    "ROADMAP.md",
    "IMPLEMENTATION_PLAN.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx src/cli.ts",
    "test": "vitest run",
    "test:ci": "vitest run --exclude tests/cli.test.ts --exclude tests/patch-proof.test.ts --exclude tests/viral-eval.test.ts --exclude tests/workflow.e2e.test.ts --exclude tests/worktree-repair.test.ts --exclude tests/mcp-verify.e2e.test.ts",
    "test:packed": "node scripts/test-packed.mjs",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "demo": "vite --config demo/vite.config.ts",
    "demo:build": "vite build --config demo/vite.config.ts",
    "demo:viral": "vite --config fixtures/viral-demo-react/vite.config.ts",
    "record:demo": "node scripts/record-demo.mjs",
    "record:proof-demo": "node scripts/record-action-proof-demo.mjs",
    "eval:viral": "tsx src/cli.ts eval viral --output .buttonprobe/eval/viral",
    "eval:react": "tsx src/cli.ts eval react --output .buttonprobe/eval/react",
    "eval:vue": "tsx src/cli.ts eval vue --output .buttonprobe/eval/vue",
    "eval:external": "tsx src/cli.ts eval external --manifest fixtures/external-react/manifest.json --allow-network --output .buttonprobe/eval/external"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/compiler-sfc": "^3.5.41",
    "commander": "^15.0.0",
    "playwright": "^1.62.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.19.8",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "lucide-react": "^1.28.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  }
}
