  "label": "No-op state update",
  "sourceFile": "src/App.vue",
  "scenario": { "expect": [{ "type": "text", "value": "fixed" }] },
  "source": "<script setup lang=\"ts\">\nimport { ref } from \"vue\";\nconst status = ref(\"idle\");\nfunction save() { status.value = status.value; }\n</script>\n<template>\n  <div>\n    <button data-testid=\"noop-state\" @click=\"save\">No-op state update</button>\n    <span data-testid=\"status\">{{ status }}</span>\n  </div>\n</template>\n",
  "fixedSource": "<script setup lang=\"ts\">\nimport { ref } from \"vue\";\nconst status = ref(\"idle\");\nfunction save() { status.value = \"fixed\"; }\n</script>\n<template>\n  <div>\n    <button data-testid=\"noop-state\" @click=\"save\">No-op state update</button>\n    <span data-testid=\"status\">{{ status }}</span>\n  </div>\n</template>\n"
